# Copy this file to android/keystore.properties (which is gitignored)
# or set these keys in ~/.gradle/gradle.properties or environment variables.
# Keystore paths are relative to android/app/.

HORECA_UPLOAD_STORE_FILE=horeca-release.keystore
HORECA_UPLOAD_STORE_PASSWORD=change-me
HORECA_UPLOAD_KEY_ALIAS=horecaKey
HORECA_UPLOAD_KEY_PASSWORD=change-me

SACCO_UPLOAD_STORE_FILE=sacco-release.keystore
SACCO_UPLOAD_STORE_PASSWORD=change-me
SACCO_UPLOAD_KEY_ALIAS=saccoKey
SACCO_UPLOAD_KEY_PASSWORD=change-me

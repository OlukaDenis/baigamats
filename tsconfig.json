{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "jsx": "react-native",
    "types": ["jest"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@shared": ["src/shared/index"],
      "@shared/*": ["src/shared/*"],
      "@sacco": ["src/apps/sacco/SaccoApp"],
      "@sacco/*": ["src/apps/sacco/*"],
      "@horeca": ["src/apps/horeca/HorecaApp"],
      "@horeca/*": ["src/apps/horeca/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "**/Pods/**"
  ]
}
